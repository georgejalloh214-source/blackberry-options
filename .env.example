# Market data provider (Finnhub / Polygon free tier). Optional in v1 — mock data without it.
MARKET_DATA_API_KEY=
# Options flow provider. Optional in v1 — sample flow without it.
FLOW_DATA_API_KEY=
# Python bot API base URL (MarketTrend, EntrySignals, WhaleHunter, RiskManager). Mock adapter without it.
BOT_API_URL=
# Magica AI key (server-side only) and optional model override.
MAGICA_API_KEY=
MAGICA_LLM_MODEL=~google/gemini-flash-latest
# Upstash / Vercel KV for paper trading storage. In-memory fallback (local dev only) without it.
KV_REST_API_URL=
KV_REST_API_TOKEN=
